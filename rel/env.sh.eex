#!/bin/sh

# Cluster the Fly machines over the private 6PN network (ADR-0013): each
# node is named after its private IP and discovers peers via DNSCluster
# (DNS_CLUSTER_QUERY in fly.toml). 6PN is IPv6-only, hence inet6_tcp.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
export ERL_AFLAGS="-proto_dist inet6_tcp"
