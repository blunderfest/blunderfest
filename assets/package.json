{
  "name": "blunderfest-assets",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-engine.mjs && node scripts/build-openings.mjs && vite",
    "build": "node scripts/copy-engine.mjs && node scripts/build-openings.mjs && tsc -b && vite build",
    "test": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xstate/store": "^4.2.3",
    "@xstate/store-react": "^2.0.0",
    "chess.js": "^1.4.0",
    "i18next": "^26.4.2",
    "phoenix": "^1.8.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "stockfish": "^19.0.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.2",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
